      "id": "code",
      "kind": "code",
      "lang": "python",
      "source": "seen = set(nums)\nbest = 0\n\nfor n in seen:\n    if n - 1 in seen:\n        continue\n\n    length = 1\n    while n + length in seen:\n        length += 1\n    best = max(best, length)"
    },
