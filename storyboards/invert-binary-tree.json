    {
      "id": "code",
      "kind": "code",
      "lang": "python",
      "source": "def invertTree(root):\n    if not root:\n        return None\n    root.left, root.right = root.right, root.left\n    invertTree(root.left)\n    invertTree(root.right)\n    return root"
    },
    {
      "id": "ctext",
      "kind": "text",
      "title": "Why it's fast",
      "body": [
        "Each node is visited exactly once → O(n)",
        "The call stack is as deep as the tree → O(h) space"
      ],
      "variant": "bullets"
    },
    {
      "id": "otext",
      "kind": "text",
      "body": [
