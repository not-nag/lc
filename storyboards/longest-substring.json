    {
      "id": "code",
      "kind": "code",
      "lang": "python",
      "source": "def lengthOfLongestSubstring(s):\n    last = {}\n    left = best = 0\n    for right, ch in enumerate(s):\n        if ch in last and last[ch] >= left:\n            left = last[ch] + 1\n        last[ch] = right\n        best = max(best, right - left + 1)\n    return best"
    },
    {
      "id": "ctext",
      "kind": "text",
      "title": "Why it's fast",
      "body": [
        "Each pointer crosses the string once → O(n)",
        "The map holds one entry per distinct character → O(k)",
        "Cubic becomes linear."
      ],
      "variant": "bullets"
    },
    {
      "id": "otext",
      "kind": "text",
      "body": [
        "If both ends only move forward,",
        "you have a sliding window."
      ],
      "variant": "big"
    }
  ],
