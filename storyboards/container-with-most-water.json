    {
      "id": "code",
      "kind": "code",
      "lang": "python",
      "source": "left, right = 0, n - 1\nbest = 0\n\nwhile left < right:\n    depth = min(height[left], height[right])\n    water = depth * (right - left)\n    best  = max(best, water)\n\n    if height[left] < height[right]: left += 1\n    else: right -= 1"
    },
    {
      "id": "ctext",
      "kind": "text",
