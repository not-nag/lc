    {
      "id": "code",
      "kind": "code",
      "lang": "python",
      "source": "def reverseList(head):\n    prev = None\n    cur = head\n    while cur:\n        nxt = cur.next\n        cur.next = prev\n        prev = cur\n        cur = nxt\n    return prev"
    },
    {
      "id": "ctext",
      "kind": "text",
      "title": "Why it's fast",
      "body": [
        "Every node is touched exactly once → O(n)",
        "Only three pointers are ever stored → O(1) space"
      ],
      "variant": "bullets"
    },
    {
      "id": "otext",
      "kind": "text",
      "body": [
        "Save the bridge",
        "before you burn it."
      ],
      "variant": "big"
    }
  ],
