    {
      "id": "code",
      "kind": "code",
      "lang": "python",
      "source": "def numIslands(grid):\n    count = 0\n    for r in range(rows):\n        for c in range(cols):\n            if grid[r][c] == '1':\n                count += 1\n                sink(r, c)\n    return count\n\ndef sink(r, c):\n    if out_of_bounds or grid[r][c] == '0':\n        return\n    grid[r][c] = '0'\n    for dr, dc in DIRS:\n        sink(r + dr, c + dc)"
    },
    {
      "id": "ctext",
      "kind": "text",
      "title": "Why it's fast",
      "body": [
        "Every cell is scanned once and sunk at most once → O(rows × cols)",
        "The stack holds at most the whole grid → O(rows × cols) space"
      ],
      "variant": "bullets"
    },
    {
      "id": "otext",
      "kind": "text",
      "body": [
        "Mutating the input",
        "is the memo."
      ],
      "variant": "big"
    }
  ],
