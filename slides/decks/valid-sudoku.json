    {
      "id": "code",
      "kind": "code",
      "lang": "python",
      "source": "rows, cols, boxes = defaultdict(set), defaultdict(set), defaultdict(set)\n\nfor r in range(9):\n    for c in range(9):\n        v = board[r][c]\n        if v == \".\": continue\n        b = (r // 3, c // 3)\n        if v in rows[r] or v in cols[c] or v in boxes[b]:\n            return False\n        rows[r].add(v); cols[c].add(v); boxes[b].add(v)\n\nreturn True"
    },
