      "id": "code",
      "kind": "code",
      "lang": "python",
      "source": "count = {}\nleft = best = 0\n\nfor right, ch in enumerate(s):\n    count[ch] = count.get(ch, 0) + 1\n    while (right - left + 1) - max(count.values()) > k:\n        count[s[left]] -= 1\n        left += 1\n    best = max(best, right - left + 1)"
    },
