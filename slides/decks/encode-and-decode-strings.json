    {
      "id": "code",
      "kind": "code",
      "lang": "python",
      "source": "def encode(strs):\n    return \"\".join(f\"{len(s)}#{s}\" for s in strs)\n\ndef decode(s):\n    out, i = [], 0\n    while i < len(s):\n        j = s.index(\"#\", i)\n        n = int(s[i:j])\n        out.append(s[j + 1 : j + 1 + n])\n        i = j + 1 + n\n    return out"
    },
    {
