    {
      "id": "code",
      "kind": "code",
      "lang": "python",
      "source": "dq, out = deque(), []\n\nfor i, n in enumerate(nums):\n    while dq and nums[dq[-1]] < n:\n        dq.pop()\n    dq.append(i)\n\n    if dq[0] <= i - k:\n        dq.popleft()\n    if i >= k - 1:\n        out.append(nums[dq[0]])"
    },
