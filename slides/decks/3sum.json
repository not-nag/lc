    {
      "id": "code",
      "kind": "code",
      "lang": "python",
      "source": "nums.sort()\n\nfor i in range(len(nums) - 2):\n    if i and nums[i] == nums[i - 1]: continue\n    l, r = i + 1, len(nums) - 1\n    while l < r:\n        total = nums[i] + nums[l] + nums[r]\n        if total < 0: l += 1\n        elif total > 0: r -= 1\n        else:\n            out.append([nums[i], nums[l], nums[r]])\n            l += 1"
    },
