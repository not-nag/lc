    {
      "id": "code",
      "kind": "code",
      "lang": "python",
      "source": "need = Counter(s1)\nwindow = Counter(s2[:len(s1)])\n\nif window == need: return True\nfor i in range(len(s1), len(s2)):\n    window[s2[i]] += 1\n    window[s2[i - len(s1)]] -= 1\n    if window == need: return True"
    },
