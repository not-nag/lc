      "id": "code",
      "kind": "code",
      "lang": "python",
      "source": "groups = defaultdict(list)\n\nfor word in strs:\n    key = \"\".join(sorted(word))\n    groups[key].append(word)\n\nreturn list(groups.values())"
    },
