    {
      "id": "code",
      "kind": "code",
      "lang": "python",
      "source": "l, r = 0, len(h) - 1\nmaxL, maxR, total = h[l], h[r], 0\n\nwhile l < r:\n    if maxL < maxR:\n        l += 1\n        maxL = max(maxL, h[l])\n        total += maxL - h[l]\n    else:\n        r -= 1\n        maxR = max(maxR, h[r])\n        total += maxR - h[r]"
    },
