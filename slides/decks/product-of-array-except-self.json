      "id": "code",
      "kind": "code",
      "lang": "python",
      "source": "out = [1] * n\n\nrunning = 1\nfor i in range(n):\n    out[i] = running\n    running *= nums[i]\n\nrunning = 1\nfor i in range(n - 1, -1, -1):\n    out[i] *= running\n    running *= nums[i]"
    },
