          "id": "walkthrough-4-31",
          "ops": [
            {
              "type": "arch.node",
              "view": "arch",
              "id": "keys",
              "label": "Key service",
              "sub": "hands out ranges",
              "kind": "service",
              "tier": 2,
              "row": 1
