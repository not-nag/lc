        {
          "id": "problem-2-0",
          "ops": [],
          "note": "Three requirements drive every decision from here. Redirects are fast, because a person is waiting. A code never collides or changes. And links live for five years.",
          "structural": false
        }
      ]
    },
    {
      "id": "estimate-3",
      "kind": "estimate",
      "layout": [
        {
          "view": "schema",
          "col": 0,
          "span": 6,
          "row": 0,
          "rowSpan": 1
        },
