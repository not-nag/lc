      "source": "POST /urls   {\"long_url\": \"https://…\"}\n  → 201  {\"code\": \"x7Kp2Qa\"}\n\nGET  /x7Kp2Qa\n  → 302  Location: https://…"
    },
    {
      "id": "reqs",
      "kind": "text",
      "title": "Three requirements drive everything",
      "body": [
        "Redirects are fast — someone is waiting on a click",
        "A code never collides and never changes",
        "Links live for 5 years"
      ],
      "variant": "bullets"
    },
    {
      "id": "schema",
      "label": "one table",
      "kind": "code",
      "lang": "sql",
      "source": "CREATE TABLE urls (\n  code        CHAR(7) PRIMARY KEY,\n  long_url    TEXT NOT NULL,\n  created_at  TIMESTAMP\n);"
