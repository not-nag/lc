    {
      "id": "otext",
      "kind": "text",
      "title": "Intuition",
      "body": [
        "It's one lookup, read 100× per write.",
        "Cache the lookup, shard the table, and never let two servers mint the same code."
      ],
      "variant": "big"
    }
