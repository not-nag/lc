        },
        {
          "id": "walkthrough-4-30",
          "ops": [
            {
              "type": "arch.bottleneck",
              "view": "arch",
              "id": "db",
              "text": "10 shards · 10 counters"
            }
          ],
          "label": "10 counters → duplicate codes",
          "note": "With ten shards there are ten counters. Shard three and shard seven both hand out id one thousand — the same code for two different links.",
