          ],
          "label": "1.2k/s ÷ 1,000 ≈ 1 call/s ✓",
          "note": "Blocks never overlap, so codes never collide. And at twelve hundred writes a second that's about one call a second — this box will never be the bottleneck.",
          "structural": true
        },
        {
          "id": "walkthrough-4-33",
          "ops": [
            {
              "type": "arch.token",
              "view": "arch",
              "name": "r1",
              "path": [
                "client",
                "lb",
                "app",
                "cache",
                "app",
                "lb",
                "client"
