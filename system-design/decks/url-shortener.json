      "slides": [
        {
          "id": "estimate-3-0",
          "ops": [
            {
              "type": "number.set",
              "view": "est",
              "key": "new links / day",
              "value": "100M",
              "note": "the one assumption"
            }
          ],
          "label": "assume 100M new links a day",
          "note": "Assume a hundred million new links a day. Everything else falls out of that one guess.",
          "structural": true
        },
        {
          "id": "estimate-3-1",
          "ops": [
            {
              "type": "number.set",
              "view": "est",
              "key": "writes / s",
              "value": "1.2k/s",
              "note": "100M ÷ 86,400 s"
            }
          ],
          "label": "100M ÷ 86,400 ≈ 1.2k/s",
          "note": "A day is eighty-six thousand four hundred seconds, so that's about twelve hundred writes a second. Not much.",
          "structural": true
        },
        {
          "id": "estimate-3-2",
          "ops": [
            {
              "type": "number.set",
              "view": "est",
              "key": "reads : writes",
              "value": "100 : 1",
              "note": "made once, clicked often"
            }
          ],
          "label": "each link is clicked ~100×",
          "note": "But a link is made once and clicked over and over. Call it a hundred clicks per link.",
          "structural": true
        },
        {
          "id": "estimate-3-3",
          "ops": [
            {
              "type": "number.set",
              "view": "est",
              "key": "reads / s",
              "value": "116k/s",
              "note": "1.2k/s × 100"
            }
          ],
          "label": "1.2k × 100 ≈ 116k/s",
          "note": "So redirects run at about a hundred and sixteen thousand a second. That's the number that shapes this design.",
          "structural": true
        },
        {
          "id": "estimate-3-4",
          "ops": [
            {
              "type": "number.set",
              "view": "est",
              "key": "row size",
              "value": "~500 B",
              "note": "7 + ~400 + 8 + index"
            }
          ],
          "label": "one row ≈ 500 bytes",
          "note": "Each row is a code, a long URL, and a timestamp. Around five hundred bytes with the index.",
          "code": {
            "view": "schema",
            "lines": [
              2,
              3,
              4
            ]
          },
          "structural": true
        },
        {
          "id": "estimate-3-5",
          "ops": [
            {
              "type": "number.set",
              "view": "est",
              "key": "storage, 5 yrs",
              "value": "91.3 TB",
              "note": "183B links × 500 B"
            }
          ],
          "label": "183B links × 500 B ≈ 91.3 TB",
          "note": "Five years of links is a hundred and eighty billion rows. Ninety-one terabytes.",
          "structural": true
        },
        {
          "id": "estimate-3-6",
          "ops": [
            {
              "type": "number.set",
              "view": "est",
              "key": "7-char codes",
              "value": "3.5T",
              "note": "62⁷ ≫ 183B links"
            }
          ],
          "label": "62⁷ = 3.5T codes — plenty",
          "note": "And is seven characters enough? Sixty-two symbols, seven places: three and a half trillion codes. Plenty.",
          "code": {
            "view": "schema",
            "lines": [
              2
            ]
          },
          "structural": true
        },
        {
          "id": "estimate-3-7",
          "ops": [
            {
              "type": "callout",
              "text": "Reads outnumber writes 100 to 1 — design for the read",
              "variant": "insight"
            }
          ],
          "note": "If you remember one number from this slide: a hundred reads for every write. Design for the read.",
          "structural": false
        }
      ]
    },
