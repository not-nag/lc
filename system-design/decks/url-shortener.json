            {
              "type": "arch.edge",
              "view": "arch",
              "from": "app",
              "to": "keys",
              "label": "1.2 calls/s",
              "async": false
            }
          ],
          "label": "reserve ids 1,000 at a time",
          "note": "One small service owns the counter. Each app server reserves a block of a thousand ids at a time and hands them out locally.",
